{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telegram MCP",
  "mainBinaryName": "Telegram MCP",
  "version": "0.1.0",
  "identifier": "app.telegram-mcp.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Telegram MCP",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
