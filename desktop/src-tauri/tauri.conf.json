{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telegram MCP",
  "mainBinaryName": "Telegram MCP",
  "version": "0.2.0",
  "identifier": "app.telegram-mcp.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Telegram MCP",
        "width": 920,
        "height": 640,
        "minWidth": 840,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "backgroundColor": "#e7e7ec"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/telegram-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
